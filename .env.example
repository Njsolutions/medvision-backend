# =============================================================================
# Amparo Online API — variáveis de ambiente de PRODUÇÃO
# Deploy no Dokploy: cadastre estas variáveis na aba "Environment" da aplicação (não use arquivo .env no servidor).
# NUNCA comite o `.env`. Para gerar segredos: openssl rand -base64 48
# [obrigatória] = a API não funciona sem ela. [opcional] = tem padrão ou desliga um recurso.
# =============================================================================

# -----------------------------------------------------------------------------
# Servidor
# -----------------------------------------------------------------------------
# [obrigatória] Em produção precisa ser "production": liga cookies Secure e desliga a documentação.
NODE_ENV=production
# [opcional] Padrões: API_VERSION=1 e PORT=3333. O prefixo das rotas é /v{API_VERSION}.
API_VERSION=1
PORT=3333
# [opcional no Dokploy] Domínio público da API. No Dokploy o domínio é configurado na aba "Domains" (porta 3333);
# esta variável só é usada pelos docker-compose.prod.yml / deploy.sh antigos. Sem https://.
API_DOMAIN=medvision.njsolutions.com.br
# [obrigatória] URL pública da API (entra no link de verificação das assinaturas).
APP_URL=https://medvision.njsolutions.com.br
# [obrigatória] URL pública do frontend, sem barra final. Vai nos links e na logo dos e-mails
# (primeiro acesso: {FRONTEND_URL}/reset-password?token=...).
FRONTEND_URL=https://amparoonline.njsolutions.com.br
# [obrigatória] Origens do frontend permitidas (CORS, proteção CSRF e WebSocket), separadas por vírgula.
# Origem exata: esquema + domínio, sem barra final e sem caminho.
# Frontend e API precisam estar no MESMO SITE (aqui, os dois são subdomínios de njsolutions.com.br),
# senão o cookie de sessão (SameSite=Lax) não é enviado.
CORS_ORIGINS=https://amparoonline.njsolutions.com.br

# -----------------------------------------------------------------------------
# Banco de dados
# -----------------------------------------------------------------------------
# [obrigatória] PostgreSQL usado pela API e pelo serviço `migrate` (prisma migrate deploy).
DATABASE_URL=postgresql://usuario:senha@host-do-banco:5432/amparo?schema=public

# -----------------------------------------------------------------------------
# Segredos
# -----------------------------------------------------------------------------
# [obrigatória] Segredo do servidor (HMAC do código de recuperação de senha). Sem ele a API não sobe.
# Mínimo 32 caracteres aleatórios. Trocar invalida só os códigos de recuperação em andamento.
COOKIE_SECRET=troque-por-openssl-rand-base64-48
# [obrigatória] Segredo das assinaturas digitais de prescrições e solicitações.
# Trocar invalida a verificação das assinaturas já emitidas: não altere depois do primeiro uso.
SIGNATURE_SECRET_KEY=troque-por-openssl-rand-base64-48

# -----------------------------------------------------------------------------
# E-mail (Resend)
# -----------------------------------------------------------------------------
# [obrigatória] Código de recuperação de senha e link de primeiro acesso.
RESEND_API_KEY=re_troque_me
# [obrigatória] Remetente. O domínio precisa estar verificado no Resend.
EMAIL_FROM=Amparo Online <nao-responda@exemplo.com.br>

# -----------------------------------------------------------------------------
# Vídeo (Daily.co)
# -----------------------------------------------------------------------------
# [obrigatória] Salas e tokens das consultas e da UTI.
DAILY_CO_API_KEY=troque-me

# -----------------------------------------------------------------------------
# Armazenamento de arquivos (Cloudflare R2)
# -----------------------------------------------------------------------------
# [obrigatória] Exames e documentos dos pacientes.
R2_ENDPOINT=https://ID-DA-CONTA.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=troque-me
R2_SECRET_ACCESS_KEY=troque-me
R2_BUCKET_NAME=amparo-arquivos

# -----------------------------------------------------------------------------
# Observabilidade
# -----------------------------------------------------------------------------
# [opcional] Webhook do Discord que recebe os alertas de erro do frontend (POST /v1/alerts).
# Vazio desliga. Crie um webhook NOVO: o anterior deve ser tratado como vazado.
DISCORD_WEBHOOK_URL=
# [opcional] debug | info | warn | error. Padrão: info em produção.
LOG_LEVEL=info
# [opcional] Documentação em /v1/docs. Em produção fica desligada; "true" liga, e só o master acessa.
ENABLE_DOCS=false

# -----------------------------------------------------------------------------
# Notificações por WhatsApp e SMS
# -----------------------------------------------------------------------------
# [opcional] Deixe vazio se não usar. Sem URL e token, o envio por esse canal falha.
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
SMS_API_URL=
SMS_API_TOKEN=

# -----------------------------------------------------------------------------
# Seed inicial — só o cadastro do usuário master. Use uma vez e REMOVA estas variáveis do Environment.
# No Dokploy: 1) cadastre MASTER_* no Environment e faça o deploy; 2) abra o terminal do container da API
# (aba "Advanced" > "Terminal") e rode:
#   node_modules/.bin/tsx scripts/seed-master.ts
# 3) apague MASTER_PASSWORD (e as demais MASTER_*) do Environment e faça novo deploy.
# Os demais usuários (admin, médicos, pacientes) o master cadastra pelo sistema.
# -----------------------------------------------------------------------------
MASTER_NAME=Master
MASTER_EMAIL=
MASTER_CPF=
# Mínimo de 12 caracteres. Troque a senha após o primeiro login.
MASTER_PASSWORD=

# -----------------------------------------------------------------------------
# Só no docker-compose.yml de DESENVOLVIMENTO (Postgres local).
# Em produção o banco é o do DATABASE_URL.
# -----------------------------------------------------------------------------
# POSTGRES_USER=medvision
# POSTGRES_PASSWORD=troque-me
# POSTGRES_DB=medvision
# DB_PORT=5432
